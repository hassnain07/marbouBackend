# ─────────────────────────────────────────────────────────────────────────────
# MARBOU API environment template. Copy to `.env` and fill in.
# Validated at boot by src/config/env.schema.ts (Zod) — invalid values fail fast.
# ─────────────────────────────────────────────────────────────────────────────

# Runtime
NODE_ENV=development
PORT=3000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:8081

# Database (PostgreSQL with PostGIS + pg_trgm)
# In Docker Compose the host port is 5433 (mapped to container 5432) to avoid
# clashing with a local PostgreSQL on 5432. Locally use localhost:5433.
DATABASE_URL=postgresql://marbou:marbou@localhost:5433/marbou_db?schema=public

# Redis (cache, queues, pubsub, Socket.io adapter)
REDIS_URL=redis://localhost:6379

# JWT — user (≤15 min access, rotating refresh)
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-long-please
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-long-please
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# JWT — admin (separate secret/audience, issued only after TOTP)
ADMIN_JWT_SECRET=change-me-admin-secret-min-32-chars-long-please
ADMIN_JWT_ACCESS_TTL=15m
ADMIN_JWT_REFRESH_TTL=12h
ADMIN_TOTP_ENC_KEY=change-me-32-byte-hex-encryption-key-for-totp

# Phase 1: temporary bootstrap admin (replaced by TOTP admin auth in Phase 2)
# FORBIDDEN in production (AdminBootstrapGuard blocks it). Min 16 chars.
ADMIN_BOOTSTRAP_KEY=dev-bootstrap-key-change-in-prod
ADMIN_SEED_EMAIL=admin@marbou.test
ADMIN_SEED_PASSWORD=ChangeMe!2026

# Object storage (S3-compatible; MinIO for local dev — matches docker-compose credentials)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_PUBLIC_BUCKET=marbou-public
S3_PRIVATE_BUCKET=marbou-private
S3_ACCESS_KEY=marbou
S3_SECRET_KEY=marbou-secret
S3_FORCE_PATH_STYLE=true
CDN_BASE_URL=http://localhost:9000

# Email (Mailhog for local dev — matches docker-compose port)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM="MARBOU <no-reply@marbou.test>"

# Push (FCM) — JSON credentials file path or inline JSON
FCM_CREDENTIALS_JSON=

# Social providers (server-side token verification)
GOOGLE_CLIENT_IDS=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY_PATH=

# Maps (Google Places/Geocoding via capped gateway)
GOOGLE_MAPS_SERVER_KEY=
MAPS_DAILY_CAP=250
MAPS_PER_USER_DAILY=50
MAPS_PER_IP_DAILY=100

# SMS (multi-provider fallback chain; flag OFF at launch)
SMS_PROVIDER_A_DSN=
SMS_PROVIDER_B_DSN=

# WhatsApp Business OTP (flag OFF at launch)
WHATSAPP_API_URL=
WHATSAPP_TOKEN=

# Content classifier (TRS-16)
CLASSIFIER_ENDPOINT=
CLASSIFIER_TOKEN=

# Observability
SENTRY_DSN=
LOG_LEVEL=info

# Integration mode: "mock" (dev/test) or "live" (production). Mocks never load in prod.
INTEGRATIONS_MODE=mock

# Rate limiting (defaults; admin-configurable values live in DB via Phase 1)
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_DEFAULT_PER_MINUTE=60

# Dev-only helpers (NEVER set in production)
DEV_EXPOSE_OTP=true
