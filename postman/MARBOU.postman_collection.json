{
  "info": {
    "_postman_id": "marbou-p00-collection",
    "name": "MARBOU API",
    "description": "MARBOU multi-vertical marketplace API. One folder per phase.\n\nP00 rate-limit tests: run the 'P00 Rate-limit — Call N of 6' requests in order (1→6). Calls 1-5 must return 200; call 6 must return 429 with Retry-After.\n\nSee postman/README.md for full setup.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Collection-level pre-request: add Accept-Language and x-device-id to every request.",
          "// Requests that need to test the absence of x-device-id must set",
          "// pm.variables.set('skipDeviceId', true) in their own pre-request script.",
          "if (!pm.variables.get('skipDeviceId')) {",
          "  pm.request.headers.upsert({ key: 'Accept-Language', value: pm.environment.get('lang') || 'en' });",
          "  pm.request.headers.upsert({ key: 'x-device-id', value: pm.environment.get('deviceId') || 'postman-dev-001' });",
          "} else {",
          "  pm.request.headers.upsert({ key: 'Accept-Language', value: pm.environment.get('lang') || 'en' });",
          "  pm.request.headers.remove('x-device-id');",
          "}",
          "",
          "const token = pm.environment.get('userA_token');",
          "if (token && !pm.request.headers.has('Authorization')) {",
          "  pm.request.headers.upsert({ key: 'Authorization', value: 'Bearer ' + token });",
          "}"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const ct = pm.response.headers.get('Content-Type') || '';",
          "if (!ct.includes('application/json')) return;",
          "const url = pm.request.url.toString();",
          "if (url.includes('/api/docs')) return;",
          "const body = pm.response.json();",
          "pm.test('Envelope: success field is a boolean', () => {",
          "  pm.expect(typeof body.success).to.eql('boolean');",
          "});",
          "if (body.success) {",
          "  pm.test('Envelope: data and meta present', () => {",
          "    pm.expect(body).to.have.property('data');",
          "    pm.expect(body).to.have.property('meta');",
          "  });",
          "  pm.test('Envelope: meta.requestId is a non-empty string', () => {",
          "    pm.expect(body.meta.requestId).to.be.a('string').and.not.empty;",
          "  });",
          "} else {",
          "  pm.test('Envelope: error.code is a non-empty string', () => {",
          "    pm.expect(body.error.code).to.be.a('string').and.not.empty;",
          "  });",
          "  pm.test('Envelope: error.message is a non-empty string', () => {",
          "    pm.expect(body.error.message).to.be.a('string').and.not.empty;",
          "  });",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "P00 Foundation",
      "description": "Phase 0 exit-criteria tests. Run these after `docker compose -f docker/docker-compose.yml up -d` to verify the foundation.\n\nRate-limit sub-folder: run requests 1→6 in order (or use Collection Runner with 6 iterations on the single request variant).",
      "item": [
        {
          "name": "Health",
          "item": [
            {
              "name": "[P00][GET /health] Liveness",
              "request": {
                "method": "GET",
                "url": "{{baseUrl}}/health"
              },
              "event": [{
                "listen": "test",
                "script": { "type": "text/javascript", "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test('data.status is ok', () => pm.expect(b.data.status).to.eql('ok'));",
                  "pm.test('x-request-id header present', () => pm.expect(pm.response.headers.get('x-request-id')).to.be.a('string').and.not.empty);"
                ]}
              }]
            },
            {
              "name": "[P00][GET /health/ready] Readiness — all deps true",
              "request": {
                "method": "GET",
                "url": "{{baseUrl}}/health/ready"
              },
              "event": [{
                "listen": "test",
                "script": { "type": "text/javascript", "exec": [
                  "pm.test('Status 200 (all deps healthy)', () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test('db: true', () => pm.expect(b.data.db).to.be.true);",
                  "pm.test('redis: true', () => pm.expect(b.data.redis).to.be.true);",
                  "pm.test('storage: true', () => pm.expect(b.data.storage).to.be.true);"
                ]}
              }]
            }
          ]
        },
        {
          "name": "Swagger",
          "item": [
            {
              "name": "[P00][GET /api/docs-json] OpenAPI JSON valid + not enveloped",
              "request": {
                "method": "GET",
                "url": "{{baseUrl}}/api/docs-json"
              },
              "event": [{
                "listen": "test",
                "script": { "type": "text/javascript", "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test('openapi field present', () => pm.expect(b.openapi).to.be.a('string'));",
                  "pm.test('info.title is MARBOU API', () => pm.expect(b.info.title).to.eql('MARBOU API'));",
                  "pm.test('Not wrapped in envelope (no success field)', () => pm.expect(b.success).to.be.undefined);"
                ]}
              }]
            }
          ]
        },
        {
          "name": "Compression",
          "item": [
            {
              "name": "[P00] Gzip/Brotli on /api/docs-json",
              "request": {
                "method": "GET",
                "url": "{{baseUrl}}/api/docs-json",
                "header": [
                  { "key": "Accept-Encoding", "value": "gzip, br" }
                ]
              },
              "event": [{
                "listen": "test",
                "script": { "type": "text/javascript", "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Content-Encoding is gzip or br', () => {",
                  "  const enc = (pm.response.headers.get('Content-Encoding') || '').toLowerCase();",
                  "  pm.expect(['gzip', 'br']).to.include(enc,",
                  "    'Expected Content-Encoding to be gzip or br but got: ' + enc);",
                  "});"
                ]}
              }]
            }
          ]
        },
        {
          "name": "404 localization",
          "item": [
            {
              "name": "[P00][GET /nonexistent] 404 English",
              "request": {
                "method": "GET",
                "url": "{{baseUrl}}/nonexistent",
                "header": [{ "key": "Accept-Language", "value": "en" }]
              },
              "event": [{
                "listen": "test",
                "script": { "type": "text/javascript", "exec": [
                  "pm.test('Status 404', () => pm.response.to.have.status(404));",
                  "const b = pm.response.json();",
                  "pm.test('code is NOT_FOUND', () => pm.expect(b.error.code).to.eql('NOT_FOUND'));",
                  "pm.test('English message', () => pm.expect(b.error.message).to.eql('Resource not found'));",
                  "pm.test('traceId present', () => pm.expect(b.error.traceId).to.be.a('string').and.not.empty);"
                ]}
              }]
            },
            {
              "name": "[P00][GET /nonexistent] 404 Arabic",
              "request": {
                "method": "GET",
                "url": "{{baseUrl}}/nonexistent",
                "header": [{ "key": "Accept-Language", "value": "ar" }]
              },
              "event": [{
                "listen": "test",
                "script": { "type": "text/javascript", "exec": [
                  "pm.test('Status 404', () => pm.response.to.have.status(404));",
                  "const b = pm.response.json();",
                  "pm.test('Arabic message', () => pm.expect(b.error.message).to.eql('المورد غير موجود'));"
                ]}
              }]
            }
          ]
        },
        {
          "name": "Validation (422)",
          "item": [
            {
              "name": "[P00][POST /dev/echo] Invalid body → 422 with details[]",
              "request": {
                "method": "POST",
                "url": "{{baseUrl}}/dev/echo",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": { "mode": "raw", "raw": "{\"message\": 123}" }
              },
              "event": [{
                "listen": "test",
                "script": { "type": "text/javascript", "exec": [
                  "pm.test('Status 422', () => pm.response.to.have.status(422));",
                  "const b = pm.response.json();",
                  "pm.test('code VALIDATION_FAILED', () => pm.expect(b.error.code).to.eql('VALIDATION_FAILED'));",
                  "pm.test('details[] non-empty', () => { pm.expect(Array.isArray(b.error.details)).to.be.true; pm.expect(b.error.details.length).to.be.above(0); });",
                  "pm.test('details[0].field = message', () => pm.expect(b.error.details[0].field).to.eql('message'));"
                ]}
              }]
            },
            {
              "name": "[P00][POST /dev/echo] Valid body → 201 echo",
              "request": {
                "method": "POST",
                "url": "{{baseUrl}}/dev/echo",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": { "mode": "raw", "raw": "{\"message\": \"hello مرحبا\"}" }
              },
              "event": [{
                "listen": "test",
                "script": { "type": "text/javascript", "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "pm.test('data.echo matches input', () => pm.expect(pm.response.json().data.echo).to.eql('hello مرحبا'));"
                ]}
              }]
            }
          ]
        },
        {
          "name": "Rate limiting — 6 requests in order",
          "description": "Run these 6 requests in order. Calls 1-5 → 200. Call 6 → 429 with Retry-After.\n\nAll use the same x-device-id ('rl-test-device') so the counter accumulates. The collection pre-request script is bypassed for the no-device test variant below.",
          "item": [
            {
              "name": "[P00][GET /dev/rate-test] Call 1 of 6 → 200",
              "request": {
                "method": "GET",
                "url": "{{baseUrl}}/dev/rate-test",
                "header": [{ "key": "x-device-id", "value": "rl-test-device", "description": "Fixed id so the counter accumulates across all 6 calls" }]
              },
              "event": [{
                "listen": "prerequest",
                "script": { "type": "text/javascript", "exec": ["pm.variables.set('skipDeviceId', false);"] }
              }, {
                "listen": "test",
                "script": { "type": "text/javascript", "exec": [
                  "pm.test('Call 1: status 200', () => pm.response.to.have.status(200));",
                  "pm.test('X-RateLimit-Limit header present', () => pm.expect(pm.response.headers.get('x-ratelimit-limit')).to.be.a('string'));",
                  "pm.test('X-RateLimit-Remaining present', () => pm.expect(pm.response.headers.get('x-ratelimit-remaining')).to.be.a('string'));",
                  "pm.test('Retry-After NOT set on success', () => pm.expect(pm.response.headers.get('retry-after')).to.be.null);"
                ]}
              }]
            },
            {
              "name": "[P00][GET /dev/rate-test] Call 2 of 6 → 200",
              "request": { "method": "GET", "url": "{{baseUrl}}/dev/rate-test", "header": [{ "key": "x-device-id", "value": "rl-test-device" }] },
              "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Call 2: status 200', () => pm.response.to.have.status(200));"] } }]
            },
            {
              "name": "[P00][GET /dev/rate-test] Call 3 of 6 → 200",
              "request": { "method": "GET", "url": "{{baseUrl}}/dev/rate-test", "header": [{ "key": "x-device-id", "value": "rl-test-device" }] },
              "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Call 3: status 200', () => pm.response.to.have.status(200));"] } }]
            },
            {
              "name": "[P00][GET /dev/rate-test] Call 4 of 6 → 200",
              "request": { "method": "GET", "url": "{{baseUrl}}/dev/rate-test", "header": [{ "key": "x-device-id", "value": "rl-test-device" }] },
              "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Call 4: status 200', () => pm.response.to.have.status(200));"] } }]
            },
            {
              "name": "[P00][GET /dev/rate-test] Call 5 of 6 → 200",
              "request": { "method": "GET", "url": "{{baseUrl}}/dev/rate-test", "header": [{ "key": "x-device-id", "value": "rl-test-device" }] },
              "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Call 5: status 200', () => pm.response.to.have.status(200));"] } }]
            },
            {
              "name": "[P00][GET /dev/rate-test] Call 6 of 6 → 429 RATE_LIMITED",
              "request": { "method": "GET", "url": "{{baseUrl}}/dev/rate-test", "header": [{ "key": "x-device-id", "value": "rl-test-device" }] },
              "event": [{
                "listen": "test",
                "script": { "type": "text/javascript", "exec": [
                  "pm.test('Call 6: status 429', () => pm.response.to.have.status(429));",
                  "const b = pm.response.json();",
                  "pm.test('code is RATE_LIMITED', () => pm.expect(b.error.code).to.eql('RATE_LIMITED'));",
                  "pm.test('Retry-After header present and numeric', () => {",
                  "  const ra = pm.response.headers.get('retry-after') || pm.response.headers.get('Retry-After') || '';",
                  "  pm.expect(ra).to.match(/^\\d+$/, 'Retry-After should be a numeric string of seconds');",
                  "});"
                ]}
              }]
            },
            {
              "name": "[P00][GET /dev/rate-test] No x-device-id → still 429 on 6th (IP-keyed)",
              "description": "Bypasses the collection pre-request so x-device-id is NOT added. After calling this 6+ times, the IP-based counter should trigger 429.",
              "request": {
                "method": "GET",
                "url": "{{baseUrl}}/dev/rate-test"
              },
              "event": [
                {
                  "listen": "prerequest",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "// Remove x-device-id so the guard keys by IP only.",
                      "pm.request.headers.remove('x-device-id');",
                      "pm.variables.set('skipDeviceId', true);"
                    ]
                  }
                },
                {
                  "listen": "test",
                  "script": { "type": "text/javascript", "exec": [
                    "pm.test('Status 200 or 429 (200 if window not exhausted yet)', () => {",
                    "  pm.expect([200, 429]).to.include(pm.response.code);",
                    "});",
                    "pm.test('No x-device-id header sent (verify in request)', () => {",
                    "  const sent = pm.request.headers.get('x-device-id');",
                    "  pm.expect(sent).to.be.null;",
                    "});",
                    "if (pm.response.code === 429) {",
                    "  pm.test('Retry-After present on 429', () => {",
                    "    const ra = pm.response.headers.get('retry-after') || '';",
                    "    pm.expect(ra).to.match(/^\\d+$/);",
                    "  });",
                    "}"
                  ]}
                }
              ]
            }
          ]
        },
        {
          "name": "BullMQ echo job",
          "item": [
            {
              "name": "[P00][POST /dev/jobs/run/echo] Enqueue job",
              "request": {
                "method": "POST",
                "url": "{{baseUrl}}/dev/jobs/run/echo",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": { "mode": "raw", "raw": "{\"text\": \"postman-smoke\"}" }
              },
              "event": [{
                "listen": "test",
                "script": { "type": "text/javascript", "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "pm.test('data.enqueued is true', () => pm.expect(pm.response.json().data.enqueued).to.be.true);"
                ]}
              }]
            },
            {
              "name": "[P00][GET /dev/jobs/runs] Latest echo JobRun rows",
              "request": {
                "method": "GET",
                "url": { "raw": "{{baseUrl}}/dev/jobs/runs?name=echo", "query": [{ "key": "name", "value": "echo" }] }
              },
              "event": [{
                "listen": "test",
                "script": { "type": "text/javascript", "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test('data.runs is an array', () => pm.expect(Array.isArray(b.data.runs)).to.be.true);",
                  "pm.test('At least one SUCCESS run', () => {",
                  "  const successes = b.data.runs.filter(r => r.status === 'SUCCESS');",
                  "  pm.expect(successes.length).to.be.above(0, 'No SUCCESS JobRun found — did the echo job complete?');",
                  "});"
                ]}
              }]
            }
          ]
        }
      ]
    },
    {
      "name": "ZZ Smoke",
      "description": "Happy-path smoke run across all phases. Populate as phases are completed.",
      "item": []
    }
  ]
}
