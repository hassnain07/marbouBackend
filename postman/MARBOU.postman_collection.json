{
  "info": {
    "_postman_id": "marbou-p00-collection",
    "name": "MARBOU API",
    "description": "MARBOU multi-vertical marketplace API. One folder per phase. See postman/README.md for setup.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Collection-level pre-request: add Accept-Language and x-device-id to every request.",
          "pm.request.headers.upsert({ key: 'Accept-Language', value: pm.environment.get('lang') || 'en' });",
          "pm.request.headers.upsert({ key: 'x-device-id',     value: pm.environment.get('deviceId') || 'postman-dev-001' });",
          "",
          "// Auto-attach bearer token when userA_token is set.",
          "const token = pm.environment.get('userA_token');",
          "if (token && !pm.request.headers.has('Authorization')) {",
          "  pm.request.headers.upsert({ key: 'Authorization', value: 'Bearer ' + token });",
          "}"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Collection-level test: assert the response envelope on JSON responses.",
          "const ct = pm.response.headers.get('Content-Type') || '';",
          "if (ct.includes('application/json')) {",
          "  const body = pm.response.json();",
          "  // Swagger docs are not wrapped in the envelope — skip them.",
          "  if (pm.request.url.toString().includes('/api/docs')) return;",
          "  pm.test('Envelope: success field is a boolean', () => {",
          "    pm.expect(typeof body.success).to.eql('boolean');",
          "  });",
          "  if (body.success) {",
          "    pm.test('Envelope: success response has data and meta', () => {",
          "      pm.expect(body).to.have.property('data');",
          "      pm.expect(body).to.have.property('meta');",
          "    });",
          "    pm.test('Envelope: meta has requestId', () => {",
          "      pm.expect(body.meta.requestId).to.be.a('string').and.not.empty;",
          "    });",
          "  } else {",
          "    pm.test('Envelope: error response has error.code', () => {",
          "      pm.expect(body.error.code).to.be.a('string').and.not.empty;",
          "    });",
          "    pm.test('Envelope: error response has error.message', () => {",
          "      pm.expect(body.error.message).to.be.a('string').and.not.empty;",
          "    });",
          "  }",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "P00 Foundation",
      "description": "Phase 0 exit criteria tests. Run these after `docker compose up` to verify the foundation.",
      "item": [
        {
          "name": "Health",
          "item": [
            {
              "name": "[P00][GET /health] Liveness",
              "request": {
                "method": "GET",
                "url": "{{baseUrl}}/health"
              },
              "event": [{
                "listen": "test",
                "script": { "type": "text/javascript", "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test('data.status is ok', () => pm.expect(b.data.status).to.eql('ok'));",
                  "pm.test('x-request-id header present', () => pm.expect(pm.response.headers.get('x-request-id')).to.be.a('string').and.not.empty);"
                ]}
              }]
            },
            {
              "name": "[P00][GET /health/ready] Readiness",
              "request": {
                "method": "GET",
                "url": "{{baseUrl}}/health/ready"
              },
              "event": [{
                "listen": "test",
                "script": { "type": "text/javascript", "exec": [
                  "pm.test('Status 200 or 503', () => { pm.expect([200, 503]).to.include(pm.response.code); });",
                  "const b = pm.response.json();",
                  "pm.test('data has db, redis, storage booleans', () => {",
                  "  pm.expect(typeof b.data.db).to.eql('boolean');",
                  "  pm.expect(typeof b.data.redis).to.eql('boolean');",
                  "  pm.expect(typeof b.data.storage).to.eql('boolean');",
                  "});",
                  "if (pm.response.code === 200) {",
                  "  pm.test('all deps true when 200', () => {",
                  "    pm.expect(b.data.db).to.be.true;",
                  "    pm.expect(b.data.redis).to.be.true;",
                  "    pm.expect(b.data.storage).to.be.true;",
                  "  });",
                  "}"
                ]}
              }]
            }
          ]
        },
        {
          "name": "Swagger",
          "item": [
            {
              "name": "[P00][GET /api/docs-json] OpenAPI JSON valid",
              "request": {
                "method": "GET",
                "url": "{{baseUrl}}/api/docs-json"
              },
              "event": [{
                "listen": "test",
                "script": { "type": "text/javascript", "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test('openapi field present', () => pm.expect(b.openapi).to.be.a('string'));",
                  "pm.test('info.title is MARBOU API', () => pm.expect(b.info.title).to.eql('MARBOU API'));",
                  "pm.test('Not wrapped in envelope', () => pm.expect(b.success).to.be.undefined);"
                ]}
              }]
            }
          ]
        },
        {
          "name": "404 localization",
          "item": [
            {
              "name": "[P00][GET /nonexistent] 404 English",
              "request": {
                "method": "GET",
                "url": "{{baseUrl}}/nonexistent",
                "header": [{ "key": "Accept-Language", "value": "en" }]
              },
              "event": [{
                "listen": "test",
                "script": { "type": "text/javascript", "exec": [
                  "pm.test('Status 404', () => pm.response.to.have.status(404));",
                  "const b = pm.response.json();",
                  "pm.test('code is NOT_FOUND', () => pm.expect(b.error.code).to.eql('NOT_FOUND'));",
                  "pm.test('message is English', () => pm.expect(b.error.message).to.eql('Resource not found'));",
                  "pm.test('traceId present', () => pm.expect(b.error.traceId).to.be.a('string').and.not.empty);"
                ]}
              }]
            },
            {
              "name": "[P00][GET /nonexistent] 404 Arabic",
              "request": {
                "method": "GET",
                "url": "{{baseUrl}}/nonexistent",
                "header": [{ "key": "Accept-Language", "value": "ar" }]
              },
              "event": [{
                "listen": "test",
                "script": { "type": "text/javascript", "exec": [
                  "pm.test('Status 404', () => pm.response.to.have.status(404));",
                  "const b = pm.response.json();",
                  "pm.test('message is Arabic', () => pm.expect(b.error.message).to.eql('المورد غير موجود'));"
                ]}
              }]
            }
          ]
        },
        {
          "name": "Validation (422)",
          "item": [
            {
              "name": "[P00][POST /dev/echo] Invalid body → 422",
              "request": {
                "method": "POST",
                "url": "{{baseUrl}}/dev/echo",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": { "mode": "raw", "raw": "{\"message\": 123}" }
              },
              "event": [{
                "listen": "test",
                "script": { "type": "text/javascript", "exec": [
                  "pm.test('Status 422', () => pm.response.to.have.status(422));",
                  "const b = pm.response.json();",
                  "pm.test('code is VALIDATION_FAILED', () => pm.expect(b.error.code).to.eql('VALIDATION_FAILED'));",
                  "pm.test('details[] is non-empty array', () => {",
                  "  pm.expect(Array.isArray(b.error.details)).to.be.true;",
                  "  pm.expect(b.error.details.length).to.be.above(0);",
                  "});",
                  "pm.test('details[0].field is message', () => pm.expect(b.error.details[0].field).to.eql('message'));"
                ]}
              }]
            },
            {
              "name": "[P00][POST /dev/echo] Valid body → 201 echo",
              "request": {
                "method": "POST",
                "url": "{{baseUrl}}/dev/echo",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": { "mode": "raw", "raw": "{\"message\": \"hello مرحبا\"}" }
              },
              "event": [{
                "listen": "test",
                "script": { "type": "text/javascript", "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "pm.test('data.echo matches input', () => pm.expect(pm.response.json().data.echo).to.eql('hello مرحبا'));"
                ]}
              }]
            }
          ]
        },
        {
          "name": "Rate limiting",
          "item": [
            {
              "name": "[P00][GET /dev/rate-test] Calls 1-5 → 200",
              "request": {
                "method": "GET",
                "url": "{{baseUrl}}/dev/rate-test"
              },
              "event": [{
                "listen": "test",
                "script": { "type": "text/javascript", "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('X-RateLimit-Limit header present', () => pm.expect(pm.response.headers.get('x-ratelimit-limit')).to.be.a('string'));"
                ]}
              }]
            },
            {
              "name": "[P00][GET /dev/rate-test] 6th call → 429",
              "description": "Run the previous request 5 times first with the same x-device-id; this 6th call should return 429.",
              "request": {
                "method": "GET",
                "url": "{{baseUrl}}/dev/rate-test"
              },
              "event": [{
                "listen": "test",
                "script": { "type": "text/javascript", "exec": [
                  "pm.test('Status 429 or 200 (200 when Redis down/degraded)', () => {",
                  "  pm.expect([200, 429]).to.include(pm.response.code);",
                  "});",
                  "if (pm.response.code === 429) {",
                  "  const b = pm.response.json();",
                  "  pm.test('code is RATE_LIMITED', () => pm.expect(b.error.code).to.eql('RATE_LIMITED'));",
                  "  pm.test('Retry-After header present', () => pm.expect(pm.response.headers.get('retry-after')).to.be.a('string').and.not.empty);",
                  "}"
                ]}
              }]
            },
            {
              "name": "[P00][GET /dev/rate-test] Without x-device-id → keys by IP only",
              "request": {
                "method": "GET",
                "url": "{{baseUrl}}/dev/rate-test",
                "header": [{ "key": "x-device-id", "value": "", "disabled": true }]
              },
              "event": [{
                "listen": "test",
                "script": { "type": "text/javascript", "exec": [
                  "pm.test('Status 200 or 429', () => pm.expect([200, 429]).to.include(pm.response.code));"
                ]}
              }]
            }
          ]
        },
        {
          "name": "BullMQ echo job",
          "item": [
            {
              "name": "[P00][POST /dev/jobs/run/echo] Enqueue job",
              "request": {
                "method": "POST",
                "url": "{{baseUrl}}/dev/jobs/run/echo",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": { "mode": "raw", "raw": "{\"text\": \"postman-smoke\"}" }
              },
              "event": [{
                "listen": "test",
                "script": { "type": "text/javascript", "exec": [
                  "pm.test('201 or 503 (503 when Redis down)', () => pm.expect([201, 503]).to.include(pm.response.code));",
                  "if (pm.response.code === 201) {",
                  "  pm.test('data.enqueued is true', () => pm.expect(pm.response.json().data.enqueued).to.be.true);",
                  "}",
                  "if (pm.response.code === 503) {",
                  "  pm.test('code is SERVICE_UNAVAILABLE', () => pm.expect(pm.response.json().error.code).to.eql('SERVICE_UNAVAILABLE'));",
                  "}"
                ]}
              }]
            },
            {
              "name": "[P00][GET /dev/jobs/runs] Latest echo job runs",
              "request": {
                "method": "GET",
                "url": {
                  "raw": "{{baseUrl}}/dev/jobs/runs?name=echo",
                  "query": [{ "key": "name", "value": "echo" }]
                }
              },
              "event": [{
                "listen": "test",
                "script": { "type": "text/javascript", "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('data.runs is an array', () => pm.expect(Array.isArray(pm.response.json().data.runs)).to.be.true);"
                ]}
              }]
            }
          ]
        },
        {
          "name": "Compression",
          "item": [
            {
              "name": "[P00] Gzip / Brotli compression header",
              "request": {
                "method": "GET",
                "url": "{{baseUrl}}/api/docs-json",
                "header": [{ "key": "Accept-Encoding", "value": "gzip, br" }]
              },
              "event": [{
                "listen": "test",
                "script": { "type": "text/javascript", "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Content-Encoding is gzip or br (or absent for small payloads)', () => {",
                  "  const enc = pm.response.headers.get('content-encoding') || '';",
                  "  pm.expect(['gzip', 'br', '']).to.include(enc);",
                  "});"
                ]}
              }]
            }
          ]
        }
      ]
    },
    {
      "name": "ZZ Smoke",
      "description": "Happy-path smoke run covering all phases. Expand and populate as phases are completed.",
      "item": []
    }
  ]
}
